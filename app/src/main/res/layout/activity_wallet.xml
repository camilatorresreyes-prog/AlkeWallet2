<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#EAF8FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="#4FC3F7">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wallet"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gestiona tu dinero"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Balance"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:layout_marginTop="28dp" />

            <TextView
                android:id="@+id/tvSaldo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$ 0"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:layout_margin="16dp">

            <EditText
                android:id="@+id/etMonto"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Ingresa un monto"
                android:inputType="number"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="16sp"
                android:background="@android:drawable/edit_text"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnDepositar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ingresar dinero"
                android:backgroundTint="#5ED18A"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnRetirar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Retirar dinero"
                android:backgroundTint="#EF5350"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transacciones"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvMovimientos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aún no hay movimientos"
                android:textSize="16sp"
                android:textColor="#000000"
                android:padding="12dp"
                android:background="#F5F5F5" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>